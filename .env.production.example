# ===================================================================
# VisionTrace AI - Production Environment Variables Template
# Copy this file to .env.production and fill in production secrets
# ===================================================================

# Environment Mode (production / staging / development)
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# -------------------------------------------------------------------
# Backend Server & CORS Configuration
# -------------------------------------------------------------------
PORT=8000
BACKEND_CORS_ORIGINS=["https://visiontrace.vercel.app", "http://localhost:80", "http://localhost:5173"]

# -------------------------------------------------------------------
# PostgreSQL Database (pgvector extension enabled)
# -------------------------------------------------------------------
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=visiontrace_admin
POSTGRES_PASSWORD=your_secure_random_postgres_password_here
POSTGRES_DB=visiontrace_production_db
DATABASE_URL=postgresql+asyncpg://visiontrace_admin:your_secure_random_postgres_password_here@postgres:5432/visiontrace_production_db

# -------------------------------------------------------------------
# Redis Cache & Task Queue
# -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -------------------------------------------------------------------
# JWT Authentication & Cryptographic Secrets
# -------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_minimum_64_character_random_hex_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# -------------------------------------------------------------------
# Supabase Cloud Storage Buckets (videos & frames)
# -------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET_VIDEOS=videos
SUPABASE_STORAGE_BUCKET_FRAMES=frames

# -------------------------------------------------------------------
# OpenCLIP & FAISS AI Engine Configuration
# -------------------------------------------------------------------
OPENCLIP_MODEL=ViT-B-32
OPENCLIP_PRETRAINED=laion2b_s34b_b79k
FAISS_INDEX_PATH=/app/data/faiss_indexes/visiontrace_512d.index

# -------------------------------------------------------------------
# Sentry Exception Tracking & Prometheus Metrics
# -------------------------------------------------------------------
SENTRY_DSN=https://your_sentry_dsn_key@o0.ingest.sentry.io/0
PROMETHEUS_METRICS_ENABLED=true
